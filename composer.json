{
  "name": "siderall/woocommerce-integration-hub",
  "description": "WooCommerce integration architecture demo with APIs, webhooks and asynchronous synchronization.",
  "type": "wordpress-plugin",
  "license": "MIT",
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "phpstan/phpstan": "^1.12",
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "autoload": {
    "psr-4": {
      "Siderall\\WooIntegrationHub\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Siderall\\WooIntegrationHub\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse",
    "phpcs": "phpcs"
  }
}
